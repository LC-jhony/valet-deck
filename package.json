{
  "name": "valet-deck",
  "version": "0.1.1",
  "description": "Valet Deck: panel de escritorio para gestionar Laravel Valet en Linux",
  "homepage": "https://github.com/LC-jhony/valet-deck",
  "author": "LC-jhony <jhonyapm94@gmail.com>",
  "license": "MIT",
  "desktopName": "valet-deck.desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run typecheck && npm run test && bash scripts/build-rpm.sh && electron-builder --linux AppImage deb --publish never",
    "test": "vitest run",
    "dist:rpm": "bash scripts/build-rpm.sh",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "dev.valetdeck.app",
    "productName": "ValetDeck",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray-ok.png",
        "to": "tray-ok.png"
      },
      {
        "from": "resources/tray-warn.png",
        "to": "tray-warn.png"
      },
      {
        "from": "resources/tray-error.png",
        "to": "tray-error.png"
      }
    ],
    "linux": {
      "category": "Development",
      "synopsis": "Panel de escritorio para Valet Linux",
      "executableName": "valetdeck",
      "icon": "build/icons",
      "desktop": {
        "Name": "Valet Deck",
        "GenericName": "Valet manager",
        "Comment": "Panel de escritorio para Valet Linux",
        "Categories": "Development;",
        "Keywords": "Laravel;Valet;PHP;nginx;MariaDB;development;",
        "StartupNotify": "true",
        "StartupWMClass": "Valet Deck"
      },
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "appImage": {
      "artifactName": "Valet-Deck-${version}.${ext}"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.tpl",
      "afterRemove": "build/linux/after-remove.tpl"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/1024x1024.png",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Valet-Deck-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "Valet Deck",
        "CFBundleName": "Valet Deck"
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Valet-Deck-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Valet Deck",
      "artifactName": "Valet-Deck-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "LC-jhony",
      "repo": "valet-deck"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "smtp-server": "^3.21.4"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
